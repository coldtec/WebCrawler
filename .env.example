# Kopieren nach .env und Werte eintragen. .env NIE weitergeben oder einchecken.

# Anthropic Managed Agent (für "Texte automatisch generieren")
ANTHROPIC_API_KEY=
ANTHROPIC_AGENT_ID=
ANTHROPIC_ENVIRONMENT_ID=

# Zielordner für die CSV-Dateien (Netzwerkpfad oder lokaler Ordner)
OUTPUT_DIR=\\srv102\Datenaustausch\Artikelimport

# Port der lokalen App (http://localhost:PORT)
PORT=3000

# Maximale Wartezeit auf den Agenten in Millisekunden (Recherche kann dauern)
AGENT_TIMEOUT_MS=180000
